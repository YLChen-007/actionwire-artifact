{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clawgap-runtime-ground-truth-case-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "report_id", "report_name", "project", "revision", "boundary_status", "report_binding", "source_binding", "dependency_binding", "adapter", "probe", "fixture", "fixture_state", "failure_mode", "replay", "matcher", "observations", "effect_policy", "support_status", "generation", "review"],
  "properties": {
    "schema_version": {"const": "clawgap-runtime-ground-truth-case/v1"},
    "case_id": {"type": "string", "pattern": "^RVGT-[0-9a-f]{16}$"},
    "report_id": {"type": "string", "pattern": "^GT-[0-9a-f]{16}$"},
    "report_name": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "boundary_status": {"const": "eligible"},
    "report_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "workbook_path", "workbook_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "workbook_path": {"type": "string", "minLength": 1}, "workbook_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_binding": {"$ref": "#/$defs/fileList"},
    "dependency_binding": {"$ref": "#/$defs/fileList"},
    "adapter": {"type": "string", "minLength": 1},
    "probe": {"type": "string", "minLength": 1},
    "fixture": {"type": "string", "minLength": 1},
    "fixture_state": {"type": "object", "required": ["exploit", "control"], "additionalProperties": false, "properties": {"exploit": {"type": "object"}, "control": {"type": "object"}}},
    "failure_mode": {"enum": ["wrong-check", "missing-check"]},
    "replay": {
      "type": "object", "additionalProperties": false, "required": ["tool_name", "exploit_args", "control_args", "reproduction_prompt"],
      "properties": {"tool_name": {"type": "string", "minLength": 1}, "exploit_args": {"type": "object"}, "control_args": {"type": "object"}, "reproduction_prompt": {"type": "string", "minLength": 1}}
    },
    "matcher": {
      "type": "object", "additionalProperties": false, "required": ["source", "relation", "path", "exploit_value", "control_value"],
      "properties": {"source": {"enum": ["tool-argument", "fixture-state"]}, "relation": {"type": "string"}, "path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "exploit_value": {}, "control_value": {}}
    },
    "observations": {
      "type": "array", "minItems": 3,
      "items": {"type": "object", "additionalProperties": false, "required": ["stage_id", "kind", "file", "symbol", "line", "expected"], "properties": {"stage_id": {"type": "string", "pattern": "^S[0-9]+$"}, "kind": {"enum": ["handler", "gate", "boundary", "sink", "effect"]}, "file": {"type": "string", "minLength": 1}, "symbol": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "expected": {"type": "string", "minLength": 1}}}
    },
    "effect_policy": {"type": "object", "additionalProperties": false, "required": ["mode", "allow_network", "allow_host_write"], "properties": {"mode": {"enum": ["intercept", "sandbox"]}, "allow_network": {"const": "loopback-only"}, "allow_host_write": {"const": false}}},
    "support_status": {"enum": ["ready", "anchor-invalid", "generator-invalid", "review-rejected", "driver-unavailable", "fixture-unavailable"]},
    "generation": {"type": "object", "additionalProperties": false, "required": ["model", "reason"], "properties": {"model": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["status", "reviewed_case_sha256", "reason", "model"], "properties": {"status": {"enum": ["pending", "approved", "rejected"]}, "reviewed_case_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "reason": {"type": "string"}, "model": {"type": "string"}}}
  },
  "$defs": {
    "hashedFile": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "fileList": {"type": "object", "additionalProperties": false, "required": ["files"], "properties": {"files": {"type": "array", "items": {"$ref": "#/$defs/hashedFile"}}}}
  }
}
