{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "handler_type_id", "status", "observed_capability_classes", "members"
  ],
  "properties": {
    "schema_version": {"const": "handler-type-capability-observation/v1"},
    "handler_type_id": {"type": "string", "pattern": "^HT-[0-9a-f]{16}$"},
    "status": {"enum": ["uniform", "heterogeneous", "partial", "no-reachable-sink"]},
    "observed_capability_classes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "sink_ids", "capability_classes"],
        "properties": {
          "member": {"type": "string", "minLength": 1},
          "sink_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "capability_classes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
