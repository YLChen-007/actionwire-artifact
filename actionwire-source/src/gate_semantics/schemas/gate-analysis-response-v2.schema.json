{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawgap.local/schemas/gate-analysis-response-v2.schema.json",
  "title": "GateAnalysisResponseV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["semantic_ir", "evidence"],
  "properties": {
    "semantic_ir": {"$ref": "gate-semantic-ir-v2.schema.json"},
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^(C[0-9]+|P_[A-Z0-9_]+)$": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "line_start", "line_end"],
            "properties": {
              "file": {"type": "string", "minLength": 1},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1}
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
