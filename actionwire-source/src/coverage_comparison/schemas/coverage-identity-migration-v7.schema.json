{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_kind", "group_id", "old_requirement_id",
    "new_requirement_id", "old_candidate_id", "new_candidate_id",
    "old_payload_sha256", "new_payload_sha256", "disposition"
  ],
  "properties": {
    "schema_version": {"const": "coverage-identity-migration/v7"},
    "record_kind": {"enum": ["requirement", "candidate"]},
    "group_id": {"type": "string", "pattern": "^HSG-[0-9a-f]{16}$"},
    "old_requirement_id": {"type": "string", "pattern": "^(R|CAPR|SR|LIR)-[0-9a-f]{16}$"},
    "new_requirement_id": {"type": "string", "pattern": "^CR-[0-9a-f]{16}$"},
    "old_candidate_id": {"type": ["string", "null"], "pattern": "^CAND-[0-9a-f]{16}$"},
    "new_candidate_id": {"type": ["string", "null"], "pattern": "^CAND-[0-9a-f]{16}$"},
    "old_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "new_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "disposition": {"enum": ["one-to-one", "many-to-one", "removed-unknown"]}
  }
}
