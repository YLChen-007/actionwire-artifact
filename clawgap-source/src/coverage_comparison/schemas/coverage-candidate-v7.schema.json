{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "group_id", "handler_criterion_id",
    "sink_type_id", "project", "revision", "chain_id", "handler_id", "sink_id",
    "failure_mode", "requirement_id", "requirement_rule",
    "requirement_applicability", "gate_ids", "gate_semantics", "reason",
    "trigger_goal", "group_oracle_status", "semantic_ir_status", "capability_card",
    "provenance", "source_context"
  ],
  "properties": {
    "schema_version": {"const": "coverage-candidate/v7"},
    "candidate_id": {"type": "string", "pattern": "^CAND-[0-9a-f]{16}$"},
    "group_id": {"type": "string", "pattern": "^HSG-[0-9a-f]{16}$"},
    "handler_criterion_id": {"type": "string", "pattern": "^HC-[0-9a-f]{16}$"},
    "sink_type_id": {"type": "string", "pattern": "^ST-[0-9a-f]{16}$"},
    "project": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "chain_id": {"type": "string", "pattern": "^C-[0-9a-f]{12}$"},
    "handler_id": {"type": "string", "pattern": "^H-[0-9a-f]{16}$"},
    "sink_id": {"type": "string", "pattern": "^S-[0-9a-f]{16}$"},
    "failure_mode": {"enum": ["wrong-check", "missing-check"]},
    "requirement_id": {"type": "string", "pattern": "^CR-[0-9a-f]{16}$"},
    "requirement_rule": {"type": "string", "minLength": 1},
    "requirement_applicability": {"type": "string", "minLength": 1},
    "gate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^GU[0-9a-f]{20}$"}},
    "gate_semantics": {"type": "array", "items": {"type": "object"}},
    "reason": {"type": "string", "minLength": 1},
    "trigger_goal": {"type": "string", "minLength": 1},
    "group_oracle_status": {"enum": ["complete", "partial"]},
    "semantic_ir_status": {"enum": ["complete", "partial"]},
    "capability_card": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["legacy_requirement_id", "kind", "payload_sha256"],
            "properties": {
              "legacy_requirement_id": {"type": "string", "pattern": "^(R|CAPR|SR|LIR)-[0-9a-f]{16}$"},
              "kind": {"enum": ["group-oracle", "capability-card", "source-derived", "learned-invariant"]},
              "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "source_context": {"type": "object"}
  }
}
