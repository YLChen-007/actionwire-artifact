{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "requirement_source", "group_id", "handler_criterion_id",
    "sink_type_id", "project", "revision", "chain_id", "requirement_id",
    "capability_facet", "applicability", "decision", "capability_evidence",
    "call_shape_facts", "gate_ids", "covered_semantics", "gap", "uncertainty",
    "boundary_hypothesis", "protected_asset_hypothesis", "risk_if_unguarded",
    "overlap_requirement_ids"
  ],
  "properties": {
    "schema_version": {"const": "coverage-capability-assessment/v7"},
    "requirement_source": {"const": "capability-card"},
    "group_id": {"type": "string", "pattern": "^HSG-[0-9a-f]{16}$"},
    "handler_criterion_id": {"type": "string", "pattern": "^HC-[0-9a-f]{16}$"},
    "sink_type_id": {"type": "string", "pattern": "^ST-[0-9a-f]{16}$"},
    "project": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "chain_id": {"type": "string", "pattern": "^C-[0-9a-f]{12}$"},
    "requirement_id": {"type": "string", "pattern": "^CAPR-[0-9a-f]{16}$"},
    "capability_facet": {"type": "string", "minLength": 1},
    "applicability": {"enum": ["applicable", "not-applicable", "unknown"]},
    "decision": {"enum": ["covered", "wrong-check", "missing-check", "not-applicable", "unknown"]},
    "capability_evidence": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/line"}
    },
    "call_shape_facts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^GU[0-9a-f]{20}$"}},
    "covered_semantics": {"type": ["string", "null"], "minLength": 1},
    "gap": {"type": ["string", "null"], "minLength": 1},
    "uncertainty": {"type": ["string", "null"], "minLength": 1},
    "boundary_hypothesis": {"type": "string", "minLength": 1},
    "protected_asset_hypothesis": {"type": "string", "minLength": 1},
    "risk_if_unguarded": {"type": "string", "minLength": 1},
    "overlap_requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^R-[0-9a-f]{16}$"}}
  },
  "$defs": {
    "line": {
      "type": "object", "additionalProperties": false,
      "required": ["start_line", "end_line", "quote"],
      "properties": {
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1}
      }
    }
  }
}
