{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "target_id", "project", "revision", "handler_criterion_id", "handler_type_ids", "handler_ids", "sink_id", "chain_ids", "input_digest", "decision", "sink_type_id", "reference_sink", "matched_on", "reason", "evidence"],
  "properties": {
    "schema_version": {"const": "sink-type-assessment/v1"},
    "target_id": {"type": "string", "pattern": "^SA-[0-9a-f]{16}$"},
    "project": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "handler_criterion_id": {"type": "string", "pattern": "^HC-[0-9a-f]{16}$"},
    "handler_type_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^HT-[0-9a-f]{16}$"}},
    "handler_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^H-[0-9a-f]{16}$"}},
    "sink_id": {"type": "string", "pattern": "^S-[0-9a-f]{16}$"},
    "chain_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^C-[0-9a-f]{12}$"}},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["matched", "new-type"]},
    "sink_type_id": {"type": "string", "pattern": "^ST-[0-9a-f]{16}$"},
    "reference_sink": {"type": "string", "minLength": 1},
    "matched_on": {"type": "array", "uniqueItems": true, "items": {"enum": ["capability", "controlled_parameter", "defaults", "call_shape"]}},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
