{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seed_project", "sink_types"],
  "properties": {
    "schema_version": {"const": "sink-type-catalog/v1"},
    "seed_project": {"const": "nanobot"},
    "sink_types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sink_type_id", "origin", "criterion", "representative_sink", "members", "associated_handler_criterion_ids"],
        "properties": {
          "sink_type_id": {"type": "string", "pattern": "^ST-[0-9a-f]{16}$"},
          "origin": {"enum": ["nanobot-seed", "external-global"]},
          "criterion": {"$ref": "#/$defs/criterion"},
          "representative_sink": {"type": "string", "minLength": 1},
          "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "associated_handler_criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^HC-[0-9a-f]{16}$"}}
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "slugs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_family", "capability_facets", "controlled_parameter_roles", "implicit_default_facets", "call_shape_family", "canonical_label", "compatibility_rule", "distinguishing_rule"],
      "properties": {
        "capability_family": {"$ref": "#/$defs/slug"},
        "capability_facets": {"$ref": "#/$defs/slugs"},
        "controlled_parameter_roles": {"$ref": "#/$defs/slugs"},
        "implicit_default_facets": {"$ref": "#/$defs/slugs"},
        "call_shape_family": {"$ref": "#/$defs/slug"},
        "canonical_label": {"type": "string", "minLength": 1},
        "compatibility_rule": {"type": "string", "minLength": 1},
        "distinguishing_rule": {"type": "string", "minLength": 1}
      }
    }
  }
}
