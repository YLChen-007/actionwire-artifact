{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "group_id", "origin", "dimension", "rule", "applicability", "origin_chain_refs", "origin_gate_ids", "reason"],
  "properties": {
    "schema_version": {"const": "group-oracle-proposal/v1"},
    "proposal_id": {"type": "string", "pattern": "^RP-[0-9a-f]{16}$"},
    "group_id": {"type": "string", "pattern": "^HSG-[0-9a-f]{16}$"},
    "origin": {"enum": ["seed", "peer", "evidence"]},
    "dimension": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "rule": {"type": "string", "minLength": 1},
    "applicability": {"type": "string", "minLength": 1},
    "origin_chain_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["project", "revision", "chain_id"], "properties": {"project": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "chain_id": {"type": "string", "pattern": "^C-[0-9a-f]{12}$"}}}},
    "origin_gate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^GU[0-9a-f]{20}$"}},
    "origin_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EV-[0-9a-f]{16}$"}},
    "reason": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"origin": {"const": "evidence"}}},
      "then": {"required": ["origin_evidence_ids"]},
      "else": {"not": {"required": ["origin_evidence_ids"]}}
    }
  ]
}
