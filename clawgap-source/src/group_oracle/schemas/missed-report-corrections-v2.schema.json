{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "post_hoc_ground_truth_informed", "baseline", "corrections"],
  "properties": {
    "schema_version": {"const": "coverage-correction-ledger/v2"},
    "post_hoc_ground_truth_informed": {"const": true},
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["group_root", "group_manifest_sha256", "coverage_root", "coverage_manifest_sha256", "ground_truth_manifest_sha256", "provenance"],
      "properties": {
        "group_root": {"type": "string", "minLength": 1},
        "group_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_root": {"type": "string", "minLength": 1},
        "coverage_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ground_truth_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["classification", "overlay_id", "source_bindings"],
          "properties": {
            "classification": {"const": "post-hoc-benchmark-overlay"},
            "overlay_id": {"const": "astrbot-write-policy-rollback-v1"},
            "source_bindings": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            }
          }
        }
      }
    },
    "corrections": {
      "type": "array", "minItems": 20, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["report_id", "project", "report_name", "revision", "source_report", "action", "chain_ids", "groups", "existing_requirement_ids", "evidence_locators"],
        "properties": {
          "report_id": {"type": "string", "pattern": "^GT-[0-9a-f]{16}$"},
          "project": {"type": "string", "minLength": 1},
          "report_name": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1},
          "source_report": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {
            "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }},
          "action": {"enum": ["add", "refine", "reassess"]},
          "chain_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^C-[0-9a-f]{12}$"}},
          "groups": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["group_id", "handler_criterion_id", "sink_type_id"], "properties": {
            "group_id": {"type": "string", "pattern": "^HSG-[0-9a-f]{16}$"},
            "handler_criterion_id": {"type": "string", "pattern": "^HC-[0-9a-f]{16}$"},
            "sink_type_id": {"type": "string", "pattern": "^ST-[0-9a-f]{16}$"}
          }}},
          "existing_requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^R-[0-9a-f]{16}$"}},
          "evidence_locators": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_deficiency": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "missing_facts", "detail", "source_anchors"],
            "properties": {
              "kind": {"const": "current-chain-call-shape-mismatch"},
              "missing_facts": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"enum": ["capability-card", "call-shape", "semantic-ir"]}
              },
              "detail": {"type": "string", "minLength": 1},
              "source_anchors": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
