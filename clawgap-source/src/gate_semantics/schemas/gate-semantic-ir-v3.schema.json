{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateSemanticIRV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate_id", "mode", "kind", "summary", "inputs",
    "activation", "derived_values", "entry", "checks", "policies",
    "outcomes", "state_effects", "dependencies", "default", "on_error",
    "unresolved", "completeness", "status"
  ],
  "properties": {
    "schema_version": {"const": "gate-semantic-ir/v3"},
    "gate_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["predicate", "filter", "transform", "constraint"]},
    "kind": {"const": "behavior-complete"},
    "summary": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "meaning", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "activation": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "condition", "when_true", "when_false"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "condition": {"type": "string", "minLength": 1},
          "when_true": {"type": "string", "minLength": 1},
          "when_false": {"type": "string", "minLength": 1}
        }
      }
    },
    "derived_values": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "meaning", "sources", "operations", "used_by"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "operations": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "used_by": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "entry": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "id", "op", "summary", "reads", "rule", "policy_refs",
          "outcomes", "on_error", "reject_examples"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "op": {"enum": ["derive", "normalize", "allow-if", "block-if", "admit-if", "drop-if", "transform", "constrain", "prompt", "unknown"]},
          "summary": {"type": "string", "minLength": 1},
          "reads": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "rule": {"type": "string", "minLength": 1},
          "policy_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "outcomes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
          "on_error": {"type": "string", "minLength": 1},
          "reject_examples": {"type": "array", "maxItems": 2, "items": {"type": "object"}}
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "summary", "input_values", "match", "flags", "template", "rules"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["regex-table", "prompt-policy"]},
          "summary": {"type": "string", "minLength": 1},
          "input_values": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "match": {"type": "string", "minLength": 1},
          "flags": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "template": {"type": ["string", "null"]},
          "rules": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "matcher", "meaning", "outcome"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "matcher": {"type": "string", "minLength": 1},
                "meaning": {"type": "string", "minLength": 1},
                "outcome": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "outcomes": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["decision", "effect"],
        "properties": {
          "decision": {"enum": ["pass", "block", "pending", "error", "not-evaluated"]},
          "effect": {"type": "string", "minLength": 1}
        }
      }
    },
    "state_effects": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "when", "effect"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "when": {"type": "string", "minLength": 1},
          "effect": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "contract", "result_domain", "affects_outcome", "resolved"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1},
          "result_domain": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "affects_outcome": {"type": "boolean"},
          "resolved": {"type": "boolean"}
        }
      }
    },
    "default": {"type": "string", "minLength": 1},
    "on_error": {"type": "string", "minLength": 1},
    "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "completeness": {
      "type": "object", "additionalProperties": false,
      "required": ["control_flow", "policy", "context", "dependencies", "overall", "reasons"],
      "properties": {
        "control_flow": {"enum": ["complete", "partial"]},
        "policy": {"enum": ["complete", "partial"]},
        "context": {"enum": ["complete", "partial"]},
        "dependencies": {"enum": ["complete", "partial"]},
        "overall": {"enum": ["complete", "partial"]},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "status": {"enum": ["complete", "partial"]}
  }
}
